{
  "expo": {
    "name": "LatinFun",
    "slug": "latinfun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "latinfun",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.latinfun.app",
      "buildNumber": "5",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trova eventi latini vicino a te",
        "NSPhotoLibraryUsageDescription": "Carica la foto di copertina della tua scuola",
        "NSCameraUsageDescription": "Scatta una foto di copertina per la tua scuola",
        "NSMicrophoneUsageDescription": "Registra brevi clip audio per i tuoi mix",
        "NSUserTrackingUsageDescription": "Per mostrarti eventi e DJ rilevanti vicino a te",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.latinfun.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trova eventi latini vicino a te"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seleziona la foto di copertina della tua scuola",
          "cameraPermission": "Scatta la foto di copertina della tua scuola"
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "771f61dc-9dc5-4ab0-a8d9-f504824bdaa8"
      },
      "router": {}
    },
    "owner": "maurocatalini"
  }
}
